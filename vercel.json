{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/tarjetas/:slug/inicio.html",
      "destination": "/api/tarjeta-inicio?slug=:slug"
    },
    {
      "source": "/comprar",
      "destination": "/comprar_presentar.html"
    },
    {
      "source": "/.netlify/functions/:name",
      "destination": "/api/:name"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/tarjeta-inicio.js": {
      "includeFiles": "tarjeta.html"
    }
  }
}
